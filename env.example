# Tracera on-prem — copy to .env and adjust before `docker compose up`

POSTGRES_PASSWORD=

TRACERA_DEFAULT_TENANT_ID=1
TRACERA_ADMIN_EMAIL=
TRACERA_ADMIN_PASSWORD=
TRACERA_AUTOTEST_EMAIL=

# Public URL of the UI (scheme + host + port customers use in the browser)
TRACERA_PUBLIC_APP_URL=https://tracera.example.com:8088
TRACERA_CORS_ORIGINS=https://tracera.example.com:8088
TRACERA_COOKIE_SECURE=true

# Boolean env values: only true or false (not 1/0).
# Ops diagnostics at /health/detail (default off in production; 404 when disabled)
# — see optional overrides at the bottom of this file.

# 64 hex chars — generate once and keep secret
TRACERA_SECRETS_ENCRYPTION_KEY=

# Object storage (SeaweedFS S3 gateway — internal to compose; not published to the host)
TRACERA_S3_ACCESS_KEY=tracera
TRACERA_S3_SECRET_KEY=
TRACERA_S3_BUCKET=tracera

# Production: smtp (required). Do not use log in production — it writes invite/reset links with
# plain tokens to API logs. log is for local dev / CI only (set TRACERA_MAIL_TRANSPORT=log).
TRACERA_MAIL_TRANSPORT=smtp
TRACERA_MAIL_SMTP_HOST=smtp.example.com
TRACERA_MAIL_SMTP_PORT=587
TRACERA_MAIL_SMTP_TLS=starttls
TRACERA_MAIL_SMTP_USERNAME=
TRACERA_MAIL_SMTP_PASSWORD=
TRACERA_MAIL_FROM_ADDRESS=noreply@example.com
TRACERA_MAIL_FROM_NAME=Tracera

# Optional host port overrides if 8080/8088 are taken
# TRACERA_HOST_API_PORT=8080
# TRACERA_HOST_UI_PORT=8088

# Optional medium-profile / ops overrides (compose already defaults these for on-prem)
# TRACERA_DB_POOL_MAX_SIZE=40
# TRACERA_HTTP_LONG_REQUEST_TIMEOUT_SECS=300
# TRACERA_ENABLE_HEALTH_DETAIL=false

# API log filter (default info — do not enable tower_http=debug in production)
# RUST_LOG=info
