# Copy to .env. Empty Required fields fail `docker compose up`.
# Secrets: openssl rand -base64 24   /   encryption key: openssl rand -hex 32

# Required
POSTGRES_PASSWORD=
TRACERA_ADMIN_EMAIL=
TRACERA_ADMIN_PASSWORD=
TRACERA_SECRETS_ENCRYPTION_KEY=
TRACERA_S3_SECRET_KEY=
TRACERA_PUBLIC_APP_URL=http://127.0.0.1:8088
TRACERA_CORS_ORIGINS=http://127.0.0.1:8088
TRACERA_MAIL_TRANSPORT=smtp
TRACERA_MAIL_SMTP_HOST=
TRACERA_MAIL_SMTP_PORT=587
TRACERA_MAIL_SMTP_TLS=starttls
TRACERA_MAIL_SMTP_USERNAME=
TRACERA_MAIL_SMTP_PASSWORD=
TRACERA_MAIL_FROM_ADDRESS=
TRACERA_MAIL_FROM_NAME=Tracera

# Optional
TRACERA_COOKIE_SECURE=false

TRACERA_S3_ACCESS_KEY=tracera
TRACERA_S3_BUCKET=tracera

# TRACERA_HOST_API_PORT=8080
# TRACERA_HOST_UI_PORT=8088

TRACERA_LICENSE_HOST_PATH=./tracera.license

# TRACERA_DB_POOL_MAX_SIZE=40
# TRACERA_HTTP_LONG_REQUEST_TIMEOUT_SECS=300
# TRACERA_ENABLE_HEALTH_DETAIL=false
# RUST_LOG=info
